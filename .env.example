# POS API origin (Nobo_Pos_Next). No trailing slash.
VITE_API_BASE_URL=http://localhost:3000
# Where uploaded images are served (same value as NEXT_PUBLIC_IMAGE_BASE_URL in the POS).
VITE_IMAGE_BASE_URL=http://localhost:3000
# Public website, used for the "Share with readers" link.
VITE_SITE_URL=https://nobokothon.com
# Website (e-commerce) image host: author photos come from the website profile.
VITE_SITE_IMAGE_BASE_URL=http://localhost:3001
# Help line shown on sign-in and onboarding screens.
VITE_HELP_PHONE=01700-000000
